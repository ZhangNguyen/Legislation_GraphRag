OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
HF_TOKEN=your_hf_token

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_chunks

NORMALIZED_DIR=data/normalized
NORMALIZED_GLOB=*.*
GRAPH_SNAPSHOT_PATH=outputs/runtime/runtime_graph_snapshot.json
BM25_STATS_PATH=outputs/bm25/bm25_stats.json
QUESTION_DEBUG_LOG_PATH=outputs/debug/question_debug.jsonl
RETRIEVAL_PIPELINE=tree_guided

QDRANT_TOP_K=20
FINAL_TOP_K=5
CROSS_TOP_K=12
MAX_GRAPH_HOPS=2
MAX_GRAPH_NODES=70

DOC_TOP_K=3
CONTENT_TOP_K_PER_DOC=3
REFERENCE_HYBRID_THRESHOLD=0.85
RRF_K=60

ENABLE_LLM_TREE_JUDGE=1
ENABLE_POST_ANSWER_VERIFIER=1
TREE_SUMMARY_TOP_K=12
TREE_DIRECT_TOP_K=8
TREE_JUDGE_TOP_K=4
TREE_EVIDENCE_TOP_K=4
TREE_BRANCH_LEAF_TOP_K=12
TREE_MAX_HOPS=3
TREE_NEIGHBOR_PREVIEW_LIMIT=5
TREE_ANSWER_RETRY_ROUNDS=1
TREE_ANSWER_RETRY_INCREMENT=4

ENABLE_LOCAL_ADEQUACY_JUDGE=1
LOCAL_JUDGE_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_JUDGE_TIMEOUT_S=20

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_TOP_N=12

ANSWER_MAX_CONTEXT_PASSAGES=5
ANSWER_MAX_SOURCE_ITEMS=5

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*
