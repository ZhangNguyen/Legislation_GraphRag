OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
HF_TOKEN=your_hf_token

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_chunks

NORMALIZED_DIR=data/normalized
NORMALIZED_GLOB=*.*
GRAPH_SNAPSHOT_PATH=outputs/runtime/runtime_graph_snapshot.json
BM25_STATS_PATH=outputs/bm25/bm25_stats.json

QDRANT_TOP_K=20
FINAL_TOP_K=5
CROSS_TOP_K=12
MAX_GRAPH_HOPS=2
MAX_GRAPH_NODES=70

DOC_TOP_K=3
CONTENT_TOP_K_PER_DOC=3
REFERENCE_HYBRID_THRESHOLD=0.85
RRF_K=60

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_TOP_N=12

ANSWER_MAX_CONTEXT_PASSAGES=5
ANSWER_MAX_SOURCE_ITEMS=5

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*
